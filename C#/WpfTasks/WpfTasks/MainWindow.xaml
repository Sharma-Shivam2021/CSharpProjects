        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfTasks"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button Content="Button" HorizontalAlignment="Left" VerticalAlignment="Top" Height="45" Width="112" Click="Button_Click2" FontSize="24" x:Name="MyButton" Margin="10,10,0,0"/>
        <WebBrowser x:Name="MyWebBrowser" Margin="10,65,10,10" />

    </Grid>
</Window>
