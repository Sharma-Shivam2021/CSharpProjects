<Window x:Class="Todo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tasks" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Input + Buttons -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <Label Content="Day"/>
            <TextBox  Width="200"
                     Text="{Binding NewDay, 
                UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10">
            <Label Content="Task"/>
            <TextBox Width="200"
                     Text="{Binding NewTask, 
                UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,10" HorizontalAlignment="Left">
        <Button Content="Add" Click="AddTask_Click" Margin="5,0"/>
            <Button Content="Update" Click="UpdateTask_Click" Margin="5,0"/>
            <Button Content="Delete" Click="DeleteTask_Click" Margin="5,0"/>
        </StackPanel>

        <!-- Task List -->
        <DataGrid ItemsSource="{Binding Tasks}"
                  SelectedItem="{Binding SelectedTask}"
                  AutoGenerateColumns="False"
                  Grid.Row="3">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="*"/>
                <DataGridTextColumn Header="Task Name" Binding="{Binding TaskName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
